        radial-gradient(circle at 30% 25%, #d6d1ff, #7c6cff 38%, #29245e 72%, #10152b);
      border: 7px solid rgba(255,255,255,0.08);
      box-shadow:
        0 0 70px rgba(104, 94, 255, 0.22),
        inset 0 8px 25px rgba(255,255,255,0.18);
    }

    .token-info h3 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .token-info p {
      color: #929db8;
      margin-bottom: 25px;
    }

    .token-details {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
