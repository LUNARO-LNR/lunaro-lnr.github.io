    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .stat-card {
      padding: 24px 18px;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.075);
      background: linear-gradient(
