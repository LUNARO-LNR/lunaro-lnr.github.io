    }

    .community h2 {
      font-size: clamp(30px, 5vw, 45px);
      margin-bottom: 14px;
    }

    .community p {
      max-width: 650px;
      margin: 0 auto;
      color: #8c97b1;
      line-height: 1.8;
    }

    .community-buttons {
      margin-top: 27px;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 50px 0 30px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      align-items: flex-start;
    }

    .footer-brand p {
      color: #727d97;
