      background: rgba(255,255,255,0.035);
      border: 1px solid rgba(255,255,255,0.065);
    }

    .transparency-card .icon {
      font-size: 25px;
      margin-bottom: 18px;
    }

    .transparency-card h3 {
      font-size: 17px;
      margin-bottom: 8px;
