      color: white;
    }

    .copyright {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.05);
      color: #566078;
      font-size: 11px;
      text-align: center;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 850px) {

      .nav-links a:not(.nav-cta) {
        display: none;
      }

      .nav-links {
        gap: 8px;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .about-grid,
      .token-main {
        grid-template-columns: 1fr;
      }

      .steps,
      .roadmap {
        grid-template-columns: repeat(2, 1fr);
      }

      .transparency-grid {
        grid-template-columns: 1fr;
      }

      .token-main {
        text-align: center;
      }

      .token-details {
        text-align: left;
      }

      .allocation-row {
        grid-template-columns: 1fr;
        gap: 5px;
      }

      .allocation-percent,
      .allocation-amount {
        text-align: left;
      }
    }

    @media (max-width: 560px) {

      .container {
        width: min(100% - 24px, 1120px);
      }

      .nav-inner {
        min-height: 65px;
      }

      .brand {
        font-size: 16px;
      }

      .brand-icon {
        width: 35px;
        height: 35px;
        font-size: 19px;
      }

      .hero {
        padding-top: 125px;
        padding-bottom: 70px;
      }

      .hero-logo {
        width: 86px;
        height: 86px;
        font-size: 43px;
        border-radius: 25px;
      }

      .hero h1 {
        font-size: 48px;
        letter-spacing: -2px;
      }

      .hero-subtitle {
        font-size: 15px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .hero-buttons .btn {
        width: 100%;
      }

      section {
        padding: 72px 0;
      }

      .stats-grid {
        gap: 9px;
      }

      .stat-card {
        padding: 19px 10px;
      }

      .stat-value {
        font-size: 19px;
      }

      .stat-label {
        font-size: 10px;
      }

      .glass-card,
      .token-card {
        padding: 23px;
      }

      .steps,
      .roadmap {
        grid-template-columns: 1fr;
      }

      .coin {
        width: 135px;
        height: 135px;
        font-size: 52px;
      }

      .token-info h3 {
        font-size: 28px;
      }

      .token-details {
        grid-template-columns: 1fr;
      }

      .community {
        padding: 50px 20px;
      }

      .community-buttons {
        flex-direction: column;
      }

      .community-buttons .btn {
        width: 100%;
      }

      .footer-top {
        flex-direction: column;
      }

      .footer-links {
        gap: 15px;
      }
    }
  </style>
</head>

