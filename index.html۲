      border: 1px solid rgba(255,255,255,0.06);
    }

    .detail span {
      display: block;
      color: #77839e;
      font-size: 11px;
      margin-bottom: 3px;
    }

    .detail strong {
      font-size: 14px;
    }

    /* =========================
       TOKENOMICS
    ========================= */

    .allocation {
      display: grid;
      gap: 13px;
    }

    .allocation-row {
      display: grid;
      grid-template-columns: 1fr 80px 170px;
      align-items: center;
      gap: 15px;
      padding: 17px 19px;
      border-radius: 15px;
      background: rgba(255,255,255,0.035);
      border: 1px solid rgba(255,255,255,0.055);
